{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-era-presentation-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": [
        "newEraPresentation@lvnsk.jp"
      ]
    }
  ],
  "vars": {
    "APP_NAME": "New Era Presentation",
    "APP_BASE_URL": "https://new-era-presentation.lvnsk.jp"
  },
  "observability": {
    "enabled": true
  }
}
